{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "excel-sync-worker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "saaas.guessyy.ccwu.cc",
      "custom_domain": true
    }
  ],
  "vars": {
    "RETENTION_LIMIT": "20",
    "SESSION_TTL_SECONDS": "2592000",
    "CLIENT_LATEST_VERSION": "1.4.1",
    "CLIENT_MINIMUM_VERSION": "1.3.1",
    "CLIENT_ROLLOUT_PERCENT": "100",
    "API_VERSION": "2026-08-31"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "excel-sync",
      "database_id": "0e0b96a7-c297-4cab-8e6d-9b5ed240eb5d"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
